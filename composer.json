{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "the-shit/agent-bus",
    "type": "project",
    "description": "NATS JetStream bus so coding agents can find each other, subscribe, and send JSON to a live session.",
    "keywords": [
        "nats",
        "jetstream",
        "agents",
        "laravel-zero",
        "cli"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "laravel-zero/foundation": "^13.23",
        "laravel-zero/framework": "^13.0",
        "zaeem2396/laravel-nats": "^1.6.4"
    },
    "require-dev": {
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "pestphp/pest": "^5.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/agent-bus"
    ],
    "scripts": {
        "test": "vendor/bin/pest",
        "lint": "vendor/bin/pint",
        "build": "@php bin/agent-bus app:build agent-bus"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
