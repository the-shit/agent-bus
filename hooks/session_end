#!/usr/bin/env php
<?php

require __DIR__.'/../vendor/autoload.php';

$input = file_get_contents('php://stdin');

if ($input === false) {
    exit(0);
}

$data = json_decode($input, true);

if (! is_array($data)) {
    exit(0);
}

$sessionId = $data['sessionId'] ?? '';

if ($sessionId === '') {
    exit(0);
}

$payload = [
    'sessionId' => $sessionId,
];

$env = [
    'NATS_URL' => getenv('NATS_URL') ?: 'nats://127.0.0.1:4222',
];

$options = [
    '--type' => 'SessionEnd',
    '--payload' => json_encode($payload, JSON_THROW_ON_ERROR),
    '--session' => $sessionId,
];

if (getenv('AGENT_BUS_AGENT_TYPE')) {
    $options['--agent-type'] = getenv('AGENT_BUS_AGENT_TYPE');
}

if (getenv('AGENT_BUS_MODEL')) {
    $options['--model'] = getenv('AGENT_BUS_MODEL');
}

runAgentBus($options, $env);

$envDelete = ['NATS_URL' => getenv('NATS_URL') ?: 'nats://127.0.0.1:4222'];
$process = proc_open(
    [PHP_BINARY, __DIR__.'/../bin/agent-bus', 'delete', $sessionId],
    [1 => ['pipe', 'w'], 2 => ['pipe', 'w']],
    $pipes,
    null,
    $envDelete,
);

if (is_resource($process)) {
    fclose($pipes[1]);
    fclose($pipes[2]);
    proc_close($process);
}

exit(0);

function runAgentBus(array $options, array $env): void
{
    $process = proc_open(
        [PHP_BINARY, __DIR__.'/../bin/agent-bus', 'emit', ...formatOptions($options)],
        [
            1 => ['pipe', 'w'],
            2 => ['pipe', 'w'],
        ],
        $pipes,
        null,
        $env,
    );

    if (! is_resource($process)) {
        exit(0);
    }

    fclose($pipes[1]);
    fclose($pipes[2]);
    proc_close($process);
}

function formatOptions(array $options): array
{
    $formatted = [];

    foreach ($options as $key => $value) {
        if (str_starts_with($key, '--')) {
            $formatted[] = $key.'='.$value;
        }
    }

    return $formatted;
}
