# Broker. One variable drives both the hook hot path and the framework.
# Remote brokers take credentials inline: nats://user:pass@homelab.tail:4222
NATS_URL=nats://127.0.0.1:4222

# Loopback answers in microseconds; a tailnet broker needs more room.
AGENT_BUS_CONNECT_TIMEOUT=0.25

# JetStream stream and KV bucket. Defaults match `docker compose up -d`.
AGENT_BUS_STREAM=AGENT_BUS
AGENT_BUS_KV_BUCKET=sessions
AGENT_BUS_KV_TTL=90

# Identity stamped onto every envelope this checkout emits.
# AGENT_BUS_SESSION_ID=
# AGENT_BUS_AGENT_TYPE=
# AGENT_BUS_MODEL=

# Host sidecar.
AGENT_BUS_HERDR=herdr
# AGENT_BUS_SIDECAR_CONSUMER=
AGENT_BUS_SIDECAR_BATCH=8
AGENT_BUS_SIDECAR_EXPIRES=0.5

# Envelope tail (cold-path `monitor`).
# AGENT_BUS_MONITOR_CONSUMER=
AGENT_BUS_MONITOR_BATCH=8
AGENT_BUS_MONITOR_EXPIRES=0.5
